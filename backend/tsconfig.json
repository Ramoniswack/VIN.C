{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
  "rootDir": ".",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"]
}

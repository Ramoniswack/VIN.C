DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vin_dev?schema=public"
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-here>"
SUPABASE_ANON_KEY="<anon-key-here>"
ADMIN_EMAILS="you@example.com"
DEV_USER_EMAIL="dev@example.com"

# Notes:
# - Copy this file to .env and fill the keys. Never commit .env with secrets.

# Dev helpers:
# - In local development the server accepts header X-ADMIN=1 and X-USER-EMAIL to
#   bypass Supabase auth for convenience. Remove or disable this fallback before
#   deploying to production.
